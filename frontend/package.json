{
  "name": "django-orbit-frontend",
  "private": true,
  "description": "Build tooling for the static assets shipped in orbit/static/orbit. Not published; see CONTRIBUTING.md.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i input.css -o ../orbit/static/orbit/css/orbit.css --minify",
    "build:icons": "node build-icons.mjs",
    "vendor": "node vendor.mjs",
    "build": "npm run vendor && npm run build:icons && npm run build:css"
  },
  "devDependencies": {
    "@alpinejs/collapse": "3.17.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "alpinejs": "3.17.4",
    "apexcharts": "3.44.0",
    "esbuild": "0.28.2",
    "htmx.org": "1.9.10",
    "lucide": "1.59.0",
    "tailwindcss": "3.4.19"
  }
}
